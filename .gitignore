# Build outputs. Anchored on purpose: an unanchored `build/` also ignores the
# Kotlin package directory `com/lvgl/android/build/`.
/app/build/
/lvgl-android/build/
/build-logic/build/
/template/build/
/template/app/build/
.gradle/
.kotlin/
.idea/
*.iml
local.properties
.cxx/
*.apk
*.aab
*.hprof

# OS
.DS_Store
Thumbs.db

# Screenshots: the curated documentation set is committed; scratch files and
# the dynamic-harness output are ignored.
screenshots/_*.png
screenshots/dynamic/
!screenshots/.gitkeep

# Temporary
*.tmp
*.log
